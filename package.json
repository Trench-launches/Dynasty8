{
  "name": "dynasty8",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3530",
    "build": "next build",
    "start": "next start --port 3530",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "build:cf": "opennextjs-cloudflare build",
    "deploy": "opennextjs-cloudflare deploy",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:local": "node scripts/local-postgres.mjs",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx --env-file-if-exists=.env prisma/seed.ts",
    "db:reset-local": "dotenv -e .env -- tsx scripts/db-reset-local.ts",
    "db:generate": "prisma generate",
    "sync:markets": "tsx --conditions=react-server --env-file-if-exists=.env scripts/sync-worker.ts",
    "admin:grant": "tsx --conditions=react-server --env-file-if-exists=.env scripts/admin-grant.ts",
    "fund:worker": "tsx --conditions=react-server --env-file-if-exists=.env scripts/demolition-worker.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.17",
    "@prisma/adapter-pg": "^6.19.3",
    "@prisma/client": "^6.19.3",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@solana/web3.js": "^1.99.0",
    "bs58": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.74.0",
    "motion": "^14.14.0",
    "next": "16.4.6",
    "next-auth": "^4.24.15",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "shadcn": "^4.23.0",
    "three": "^0.187.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.187.0",
    "dotenv-cli": "^11.1.0",
    "embedded-postgres": "^18.6.0-beta.19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "prisma": "^6.19.3",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^3.2.7",
    "wrangler": "^4.164.0"
  },
  "allowScripts": {
    "@embedded-postgres/windows-x64@18.6.0-beta.19": true,
    "@embedded-postgres/linux-x64@18.6.0-beta.19": true,
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.28.2": true,
    "prisma@6.19.3": true,
    "bufferutil": false,
    "utf-8-validate": false
  },
  "engines": {
    "node": ">=22.9"
  }
}
