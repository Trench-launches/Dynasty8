{
  "name": "dynasty8-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3530",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:local": "node scripts/local-postgres.mjs",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset-local": "dotenv -e .env -- tsx scripts/db-reset-local.ts",
    "db:generate": "prisma generate",
    "sync:markets": "tsx --conditions=react-server scripts/sync-worker.ts",
    "admin:grant": "tsx --conditions=react-server scripts/admin-grant.ts",
    "fund:worker": "tsx --conditions=react-server scripts/demolition-worker.ts",
    "postinstall": "prisma generate",
    "build": "next build",
    "start": "next start --port 3530",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@solana/web3.js": "^1.99.0",
    "bs58": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.74.0",
    "motion": "^12.43.0",
    "next": "^15.5.29",
    "next-auth": "^4.24.15",
    "pino": "^10.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dotenv-cli": "^11.1.0",
    "embedded-postgres": "^18.6.0-beta.19",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.29",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "allowScripts": {
    "@embedded-postgres/windows-x64@18.6.0-beta.19": true,
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.28.2": true,
    "prisma@6.19.3": true,
    "bufferutil": false,
    "utf-8-validate": false,
    "@embedded-postgres/linux-x64@18.6.0-beta.19": true
  },
  "engines": {
    "node": ">=22"
  }
}
