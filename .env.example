# Dynasty 8 configuration. Copy to .env (gitignored) and fill in.
# Never commit real values. In production, set these in the host's secret manager.

# --- Data source (frontend) ----------------------------------------------------
# "true" = run the UI on the in-memory mock catalogue (src/lib/mock-api.ts), no database needed.
# "false" (default) = read the real backend: PostgreSQL via the API routes in this app.
NEXT_PUBLIC_MOCK_API="false"
# Mock mode only: fill some tokens with clearly labelled DEMO market data (design preview).
NEXT_PUBLIC_DEMO_MARKETS="false"
# Browser calls go to this origin. Empty = same origin (the API is served by this app).
NEXT_PUBLIC_API_BASE_URL=""

# --- Database (required unless NEXT_PUBLIC_MOCK_API=true) ------------------------
# Local: `npm run db:local` starts an embedded PostgreSQL on 54329 with these credentials.
DATABASE_URL="postgresql://dynasty8:dynasty8-local-only@127.0.0.1:54329/dynasty8"

# --- Solana (read-only) --------------------------------------------------------
# Public endpoint works but is heavily rate-limited. Use a keyed RPC (e.g. Helius) in production.
# Server-only: never expose this URL to the browser (it may contain an API key).
SOLANA_RPC_URL="https://api.mainnet-beta.solana.com"

# --- Market-data providers -----------------------------------------------------
# DexScreener and GeckoTerminal need no key. Disable with "false".
ENABLE_DEXSCREENER="true"
ENABLE_GECKOTERMINAL="true"
# Optional. Helius DAS getAsset for token metadata during mint registration.
HELIUS_API_KEY=""
# Optional. Birdeye OHLCV as a chart fallback.
BIRDEYE_API_KEY=""

MARKET_POLL_INTERVAL_MS="60000"   # sync worker cadence (min 15000)
MARKET_STALE_AFTER_MS="180000"    # snapshots older than this are reported STALE
PROVIDER_TIMEOUT_MS="8000"

# --- Admin authentication (Auth.js / NextAuth, GitHub OAuth) -------------------
# Admin routes return 401 until these are set AND an admin is granted with `npm run admin:grant`.
NEXTAUTH_URL="http://localhost:3530"
NEXTAUTH_SECRET=""                # 32+ random bytes, e.g. `openssl rand -base64 32`
GITHUB_ID=""
GITHUB_SECRET=""
ADMIN_ALLOWED_ORIGINS=""          # extra comma-separated origins allowed to call admin mutations

LOG_LEVEL="info"
# Set to 1 to run tests/live against real providers (keyless ones run without keys).
LIVE_PROVIDER_TESTS=""
